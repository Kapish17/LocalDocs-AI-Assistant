# Copy this file to backend/.env and fill in your real values.
# .env is gitignored — never commit real secrets.

# Required. Your Google AI Studio / Gemini API key.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional. Overrides the default Gemini model alias (gemini-flash-lite-latest).
# Leave unset to use the default.
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Which embedding backend rag/embeddings.py uses: "remote"
# (the default — calls Hugging Face Inference Providers' hosted
# feature-extraction API, no local PyTorch/sentence-transformers model
# loaded, which is what keeps this backend inside Render Free's 512 MB
# memory limit) or "local" (loads the embedding model locally via
# sentence-transformers/PyTorch — needs the extra dependencies in
# requirements.txt, not installed in the Docker/Render image).
# EMBEDDING_PROVIDER=remote

# Required when EMBEDDING_PROVIDER=remote (the default). A Hugging Face
# access token with "Inference Providers" permission. Get one at
# https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# Optional. Overrides the default embedding model (BAAI/bge-small-en-v1.5,
# 384 dimensions), used by both the "remote" and "local" providers.
# GEMINI_MODEL, EMBEDDING_PROVIDER, and HF_EMBEDDING_MODEL can each be
# changed independently.
# HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional. Seconds to wait for a single remote embedding request before
# treating it as failed. Defaults to 30.
# HF_EMBEDDING_TIMEOUT=30

# Optional. Comma-separated list of frontend origins allowed to call this API
# (CORS). Defaults to the local Vite dev server (http://localhost:5173) if
# unset. Set this in production to your deployed frontend's URL.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Optional alternative to CORS_ORIGINS for a single frontend origin (used
# only if CORS_ORIGINS isn't set).
# FRONTEND_URL=http://localhost:5173

# Optional, local Docker/Cloud Run only. The port the FastAPI server listens
# on. Cloud Run sets this automatically at deploy time. Defaults to 8080.
# PORT=8080
