# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit real values.

# Base URL of the FastAPI backend. No trailing slash.
# Local dev (backend run directly): http://localhost:8000
# Local dev (via docker-compose):   http://localhost:8000
# Production: the Cloud Run service URL, e.g. https://localdocs-backend-xyz.a.run.app
VITE_API_URL=http://localhost:8000
